{
  "name": "tactile-photo-gallery-kit",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run build:library",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "pack:library": "npm run build:library && node scripts/pack-library.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "verify:product": "node scripts/verify-product.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "verify:release": "npm run verify:consumers && npm run test:browser"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "oxlint": "^1.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
